# Environment variables for the app
# Copy this file to .env.local and add your real API key

# TomTom API key (REQUIRED for autocomplete)
# Get a free key at: https://developer.tomtom.com/
# VITE_TOMTOM_API_KEY=your_tomtom_key_here

# IMPORTANT: Without a TomTom key, autocomplete will be disabled
# Users will need to enter coordinates manually
